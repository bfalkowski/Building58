# Copy this file to .env and fill it in. Never commit .env.

# The key that opens the room page. Pick a long random one, for example: openssl rand -hex 16
RELAY_KEY=

# Claude Code. Set one of these.
# A token for your own Claude subscription: run `claude setup-token` on any computer and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or a Claude Console API key, billed to that account.
# ANTHROPIC_API_KEY=
# Or a cloud provider, with that provider's own settings, for example:
# CLAUDE_CODE_USE_BEDROCK=1

# GitHub. The room acts as a GitHub App of its own, installed on only the repos it works on. To make one,
# run this on your computer from the Building58 folder, press Create on GitHub, then install it:
#   node relay/github-app.js create --env <this .env file>
# It fills in these two. The key is base64 on one line. Sessions never get it, only one-hour tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional, when the App is installed on more than one account and the first repo's owner is not the one.
# GITHUB_APP_INSTALLATION_ID=
#
# Or a classic personal access token with the repo scope, which reaches every repo of your account.
# A fine-grained token is not enough: it cannot read the checks of a pull request, which the room reads.
# GH_TOKEN=

# The repos the room works on, as owner/name, by spaces or commas. Each one not in the repos volume
# yet is cloned there at the next start, with the GitHub App's token or GH_TOKEN, into /home/node/repos/<name>.
ROOM_REPOS=

# Optional. The port of the room page on this computer, http://localhost:8787 unless you set it.
# ROOM_PORT=8787

# Optional. The CPUs and memory the room may use (compose.yaml).
# ROOM_CPUS=4
# ROOM_MEMORY=8g

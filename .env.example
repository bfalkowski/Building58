# Copy this file to .env and fill it in. Never commit .env.

# The key that opens the room page. Pick a long random one, for example: openssl rand -hex 16
RELAY_KEY=

# Claude Code. Set one of these.
# A token for your own Claude subscription: run `claude setup-token` on any computer and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or a Claude Console API key, billed to that account.
# ANTHROPIC_API_KEY=
# Or a cloud provider, with that provider's own settings, for example:
# CLAUDE_CODE_USE_BEDROCK=1

# GitHub. The room acts as a GitHub App of its own, installed on only the repos it works on. To make one,
# run this on your computer from the Building58 folder, press Create on GitHub, then install it:
#   node relay/github-app.js create --env <this .env file>
# It fills in these two. The key is base64 on one line. Sessions never get it, only one-hour tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional, when the App is installed on more than one account and the first repo's owner is not the one.
# GITHUB_APP_INSTALLATION_ID=
#
# Or a classic personal access token with the repo scope, which reaches every repo of your account.
# A fine-grained token is not enough: it cannot read the checks of a pull request, which the room reads.
# GH_TOKEN=

# Optional. Only with tickets kept on GitHub issues. The key that signs each ticket's hidden note, so the
# room reads its approvals and order. Set the same value on every machine that runs the room, and a room
# moved to a new server reads the old notes. Pick a long random one: openssl rand -hex 32
# Without it, the key is github-store.key in the state folder, which a new server must be given a copy of.
# RELAY_TICKET_KEY=

# The repos the room works on, as owner/name, by spaces or commas. Each one not in the repos volume
# yet is cloned there at the next start, with the GitHub App's token or GH_TOKEN, into /home/node/repos/<name>.
ROOM_REPOS=

# The Claude Code plugins the room's briefs use, as plugin@marketplace, by spaces or commas. At each start the
# room installs each one not installed yet into the claude volume, and says which in the Skills: line of the log.
# A plugin is code that every session runs, so list only what you accept. Versions are pinned in plugins.json:
# the room installs what the marketplace offers and says when that is not the pinned version. none installs
# nothing. setup.sh asks before it keeps this. An owner/repo item adds a marketplace, such as cursor/plugins.
ROOM_PLUGINS=mattpocock-skills@claude-plugins-official, pstack@cursor-plugins

# Optional. The release whose image docker compose uses, such as 0.6.0. Unset means the latest.
# BUILDING58_VERSION=0.6.0

# Optional. The port of the room page on this computer, http://localhost:8787 unless you set it.
# ROOM_PORT=8787

# Optional. The CPUs and memory the room may use (compose.yaml).
# ROOM_CPUS=4
# ROOM_MEMORY=8g

# Optional. Remote mode: the relay checks a Cloudflare Access sign-in itself, for one owner with MFA.
# See docs/manual/relay.html#remote. With RELAY_REMOTE=1 all four others are needed.
# RELAY_REMOTE=1
# RELAY_REMOTE_URL=https://room.example.com
# RELAY_ACCESS_TEAM=myteam.cloudflareaccess.com
# RELAY_ACCESS_AUD=
# RELAY_ACCESS_EMAIL=
# RELAY_REMOTE_FULL=0   (1 lets the owner use the whole room, Claude Code panel included, through the tunnel)
# RELAY_ACCESS_MFA=amr   (cloudflare when the identity provider sends no amr, such as Google; then require MFA in the Access application)
